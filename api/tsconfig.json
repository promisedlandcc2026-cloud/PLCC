{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "..",
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "../api/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
