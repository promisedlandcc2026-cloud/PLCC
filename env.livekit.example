# LiveKit Voice Huddles (Phase 3B / 3B.2) — server-side only for secrets
# Placeholders only. Never commit real credentials.
#
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# DAILY_API_KEY=
#
# DAILY_API_KEY is server-only. Do not add a VITE_ copy.
# It opens the in-page backup huddle when LiveKit answers 429.
#
# Optional public URL mirror for local docs only (not required):
# VITE_LIVEKIT_URL=
#
# Never put LIVEKIT_API_SECRET in any VITE_* variable.
# The client must use the `url` returned by the voice-token API.
#
# ---------------------------------------------------------------------------
# Phase 3B.2 huddle-start webhook OPS RULE
# ---------------------------------------------------------------------------
# Endpoint: POST /api/livekit-webhook
#
# PREVIEW (stable branch alias ONLY — never ephemeral deploy hostnames):
#   https://awc-vault-git-feature-awc-commun-35f748-jerlessm-5552s-projects.vercel.app/api/livekit-webhook
#
# PRODUCTION (later):
#   https://<stable-production-awc-vault-domain>/api/livekit-webhook
#
# CRITICAL:
#   One LiveKit project / event stream → ONE active webhook destination.
#   Do NOT register Preview + Production URLs together on the same LiveKit
#   project (that double-delivers room_started and duplicates notifies).
#
# Preferred long-term: separate LiveKit Preview vs Production projects + credentials.
#
# Auth: signed with LIVEKIT_API_KEY + LIVEKIT_API_SECRET (WebhookReceiver).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
